{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ng serve",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder:valuecorn_frontend}"
      },
      "isBackground": true,
      "problemMatcher": {
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting development server.*",
          "endsPattern": ".*Compiled successfully.*"
        }
      }
    }
  ]
}
